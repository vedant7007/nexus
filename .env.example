# NEXUS environment — copy to .env.local for local development.
#
# NONE of these are required to run locally. With no Firebase config the app
# runs in local-dev mode (an implicit identity, no sign-in), and with no Gemini
# key every AI feature runs in deterministic rule-based mode. Fill these in only
# to exercise real auth and real Gemini.

# ── Firebase web config (public by design; safe in the client bundle) ─────────
# From the Firebase console: Project settings → your web app → SDK config.
# These are read at BUILD time and inlined into the client bundle, so a Cloud
# Run deploy must pass them as Docker build args (cloudbuild.yaml does this).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Gemini via Vertex AI — no API key needed ──────────────────────────────────
# Gemini runs through Vertex AI, authenticated by Application Default
# Credentials (the Cloud Run service account in production) and billed to the
# project's Cloud Billing account. There is no API key to set.
#
# The GCP project comes from NEXT_PUBLIC_FIREBASE_PROJECT_ID above (or set
# FIREBASE_PROJECT_ID explicitly). GEMINI_LOCATION picks the Vertex region.
# GEMINI_LOCATION=us-central1
#
# Local development only: if Application Default Credentials are not set up
# (`gcloud auth application-default login`), export a short-lived token instead:
#   GEMINI_ACCESS_TOKEN=$(gcloud auth print-access-token)
# Absent both, AI features run in deterministic rule-based mode.
# GEMINI_ACCESS_TOKEN=

# ── Test / demo only — never set this on a real deployment ────────────────────
# AUTH_BYPASS=1 skips Firebase token verification (used by the E2E build so the
# whole product can be exercised with no cloud project). A test asserts a
# production request without this flag is always rejected.
# AUTH_BYPASS=0
